---
import Icon from './Icon.astro';
import { businessContact, getContent, getRoute, type Locale } from '../i18n';

interface Props {
  text: string;
  title?: string;
  locale?: Locale;
}

const { text, locale = 'en' } = Astro.props;
const t = getContent(locale);
const title = Astro.props.title ?? t.pages.home.ctaTitle;
---

<section class="px-4 py-16 sm:px-6 lg:px-8">
  <div class="relative mx-auto max-w-7xl overflow-hidden rounded-lg bg-blue-950 px-6 py-14 text-white shadow-2xl shadow-blue-950/20 sm:px-10 lg:px-14">
    <div class="absolute inset-0 soft-grid opacity-20" aria-hidden="true"></div>
    <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-green-400/20 blur-2xl" aria-hidden="true"></div>
    <div class="relative grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
      <div class="reveal">
        <p class="mb-3 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-bold text-blue-100">
          <Icon name="sparkles" class="h-4 w-4 text-green-300" />
          {t.business.tagline}
        </p>
        <h2 class="text-3xl font-black leading-tight sm:text-4xl">{title}</h2>
        <p class="mt-4 max-w-2xl text-base leading-8 text-blue-100 sm:text-lg">{text}</p>
      </div>
      <div class="reveal reveal-delay-1 flex flex-col gap-3 sm:flex-row lg:flex-col">
        <a
          href={getRoute(locale, 'contact')}
          class="inline-flex items-center justify-center gap-2 rounded-full bg-green-500 px-7 py-4 text-base font-black text-white shadow-xl shadow-green-950/25 transition hover:-translate-y-0.5 hover:bg-green-600"
        >
          {t.labels.freeEstimate}
          <Icon name="arrowRight" class="h-5 w-5" />
        </a>
        <a
          href={businessContact.primaryPhoneHref}
          class="inline-flex items-center justify-center gap-2 rounded-full border border-white/25 px-7 py-4 text-base font-black text-white transition hover:-translate-y-0.5 hover:bg-white/10"
        >
          <Icon name="phone" class="h-5 w-5" />
          {t.labels.callNow}
        </a>
      </div>
    </div>
  </div>
</section>
