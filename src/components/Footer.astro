---
import Icon from './Icon.astro';
import { businessContact, getBusinessPhones, getContent, getRoute, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getContent(locale);
const year = new Date().getFullYear();
const phones = getBusinessPhones(locale);
---

<footer class="relative overflow-hidden bg-blue-950 text-white">
  <div class="absolute inset-0 soft-grid opacity-20" aria-hidden="true"></div>
  <div class="section-shell relative py-14">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr_0.85fr]">
      <div>
        <div class="mb-5 flex items-center gap-3">
          <img
            src={businessContact.logoPng}
            alt={`${t.business.name} logo`}
            class="h-14 w-14 rounded-lg border border-white/20 bg-white/95 object-cover shadow-lg shadow-slate-950/20"
            width="248"
            height="276"
            loading="lazy"
          />
          <div>
            <p class="text-xl font-black">{t.business.name}</p>
            <p class="text-sm font-semibold text-blue-200">{t.business.tagline}</p>
          </div>
        </div>
        <p class="max-w-md text-sm leading-7 text-blue-100">
          {t.business.catchphrase} {t.business.description}
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          {phones.map((phone) => (
            <a
              href={phone.href}
              class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-black text-blue-950 transition hover:-translate-y-0.5 hover:bg-blue-50"
            >
              <Icon name="phone" class="h-4 w-4" />
              {phone.display}
            </a>
          ))}
          <a
            href={getRoute(locale, 'contact')}
            class="inline-flex items-center gap-2 rounded-full border border-white/25 px-5 py-3 text-sm font-black text-white transition hover:-translate-y-0.5 hover:bg-white/10"
          >
            {t.labels.contactUs}
            <Icon name="arrowRight" class="h-4 w-4" />
          </a>
        </div>
      </div>

      <div>
        <h2 class="mb-4 text-sm font-black uppercase text-blue-200">{t.labels.explore}</h2>
        <ul class="grid gap-2">
          {t.navLinks.map((link) => (
            <li>
              <a href={getRoute(locale, link.key)} class="text-sm font-semibold text-blue-100 transition hover:text-white">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="mb-4 text-sm font-black uppercase text-blue-200">{t.labels.services}</h2>
        <ul class="grid gap-2">
          {t.services.map((service) => (
            <li>
              <a href={getRoute(locale, service.pageKey)} class="text-sm font-semibold text-blue-100 transition hover:text-white">
                {service.navTitle}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-6 rounded-lg border border-white/20 bg-white/10 p-4">
          <p class="text-sm font-bold text-white">{t.labels.email}</p>
          <a
            href={businessContact.emailHref}
            class="mt-1 block break-all text-sm font-semibold text-blue-100 transition hover:text-white"
          >
            {businessContact.email}
          </a>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-white/20 pt-6 text-sm text-blue-200 sm:flex-row sm:items-center sm:justify-between">
      <p>
        &copy; {year} {t.business.name}. {t.labels.rights}
      </p>
      <p>{t.business.tagline}</p>
    </div>
  </div>
</footer>
