---
import Icon from './Icon.astro';
import { business } from '../data/site';

interface Props {
  headline: string;
  subheadline: string;
  text: string;
  showButtons?: boolean;
  image?: string;
}

const {
  headline,
  subheadline,
  text,
  showButtons = true,
  image = '/images/hero-cleaning.webp',
} = Astro.props;
---

<section class="relative min-h-[calc(100svh-7rem)] overflow-hidden bg-blue-950 text-white">
  <div
    class="absolute inset-0 bg-cover bg-center"
    style={`background-image: linear-gradient(90deg, rgba(9, 24, 61, 0.92) 0%, rgba(15, 47, 118, 0.82) 43%, rgba(15, 47, 118, 0.44) 72%, rgba(15, 47, 118, 0.32) 100%), url('${image}');`}
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-0 soft-grid opacity-25" aria-hidden="true"></div>
  <div class="absolute right-[8%] top-24 hidden h-36 w-36 rounded-full border border-white/25 lg:block" style="animation: float-gently 6s ease-in-out infinite;" aria-hidden="true"></div>
  <div class="absolute bottom-24 right-[18%] hidden h-24 w-24 rounded-full bg-green-400/20 blur-sm lg:block" style="animation: float-gently 7s ease-in-out infinite;" aria-hidden="true"></div>

  <div class="section-shell relative py-20 sm:py-24 lg:py-28">
    <div class="max-w-3xl reveal">
      <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-bold text-blue-50 shadow-xl shadow-blue-950/20 backdrop-blur-md">
        <Icon name="sparkles" class="h-4 w-4 text-green-300" />
        {business.tagline}
      </div>

      <h1 class="max-w-3xl text-5xl font-black leading-[1.04] text-white sm:text-6xl lg:text-7xl">
        {headline}
      </h1>

      <p class="mt-6 max-w-2xl text-2xl font-bold leading-9 text-blue-100 sm:text-3xl">{subheadline}</p>

      <p class="mt-5 max-w-2xl text-base leading-8 text-blue-50/90 sm:text-lg">{text}</p>

      {showButtons && (
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href={business.phoneHref}
            class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-7 py-4 text-base font-black text-blue-950 shadow-xl shadow-blue-950/25 transition hover:-translate-y-0.5 hover:bg-blue-50"
          >
            <Icon name="phone" class="h-5 w-5" />
            Call Now
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-green-500 px-7 py-4 text-base font-black text-white shadow-xl shadow-green-950/20 transition hover:-translate-y-0.5 hover:bg-green-600"
          >
            Free Estimate
            <Icon name="arrowRight" class="h-5 w-5" />
          </a>
        </div>
      )}
    </div>

    <div class="mt-16 grid gap-3 sm:grid-cols-3 lg:max-w-3xl">
      {[
        ['Residential', 'Homes, condos, apartments'],
        ['Commercial', 'Offices and shared spaces'],
        ['Outdoor', 'Lawns, gardens, upkeep'],
      ].map(([label, copy], index) => (
        <div class={`reveal reveal-delay-${index + 1} rounded-lg border border-white/20 bg-white/10 p-4 backdrop-blur-md`}>
          <p class="text-sm font-black text-white">{label}</p>
          <p class="mt-1 text-sm leading-6 text-blue-50/80">{copy}</p>
        </div>
      ))}
    </div>
  </div>
</section>
