---
import Icon from './Icon.astro';
import {
  businessContact,
  getPrimaryPhone,
  getContent,
  getRoute,
  type Locale,
  type PageKey,
} from '../i18n';

const normalizePath = (path: string) => (path === '/' ? '/' : path.replace(/\/$/, ''));
const currentPath = normalizePath(Astro.url.pathname);

interface Props {
  locale?: Locale;
  pageKey: PageKey;
}

const { locale = 'en', pageKey } = Astro.props;
const t = getContent(locale);
const primaryPhone = getPrimaryPhone(locale);

const isActive = (href: string) => {
  const normalizedHref = normalizePath(href);
  return normalizedHref === '/'
    ? currentPath === '/'
    : currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
};
---

<header class="sticky top-0 z-50 border-b border-white/70 bg-white/90 shadow-[0_10px_30px_rgba(15,23,42,0.08)] backdrop-blur-xl">
  <input type="checkbox" id="mobile-menu-toggle" class="peer sr-only" aria-label={t.labels.menuToggle} />

  <div class="section-shell">
    <div class="flex h-20 items-center justify-between gap-4">
      <a href={getRoute(locale, 'home')} class="flex min-w-0 items-center gap-3 text-blue-950" aria-label={`${t.business.name} ${t.labels.homeLink}`}>
        <img
          src={businessContact.logoPng}
          alt={`${t.business.name} logo`}
          class="h-12 w-12 shrink-0 rounded-lg border border-blue-100 object-cover shadow-lg shadow-blue-950/12 sm:h-14 sm:w-14"
          width="248"
          height="276"
          loading="eager"
        />
        <span class="min-w-0">
          <span class="block truncate text-base font-black leading-5 sm:text-lg">{t.business.name}</span>
          <span class="hidden text-xs font-semibold text-blue-700 sm:block">{t.business.tagline}</span>
        </span>
      </a>

      <nav class="hidden items-center gap-1 lg:flex" aria-label={t.labels.mainNavigation}>
        {t.navLinks.map((link) => (
          link.key === 'services' ? (
            <div class="group relative">
              <a
                href={getRoute(locale, link.key)}
                class={`inline-flex items-center gap-1 rounded-full px-4 py-2 text-sm font-bold transition ${
                  isActive(getRoute(locale, link.key))
                    ? 'bg-blue-50 text-blue-950'
                    : 'text-slate-700 hover:bg-blue-50 hover:text-blue-950'
                }`}
              >
                {link.label}
                <Icon name="arrowRight" class="h-4 w-4 rotate-90 transition group-hover:translate-y-0.5" />
              </a>
              <div class="invisible absolute left-0 top-full z-50 mt-3 w-80 translate-y-2 rounded-lg border border-slate-200 bg-white p-2 opacity-0 shadow-2xl shadow-slate-950/10 transition duration-200 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                {t.services.map((service) => (
                  <a
                    href={getRoute(locale, service.pageKey)}
                    class="flex gap-3 rounded-lg p-3 transition hover:bg-blue-50"
                  >
                    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-blue-950 text-white">
                      <Icon name={service.icon} class="h-5 w-5" />
                    </span>
                    <span>
                      <span class="block text-sm font-black text-blue-950">{service.navTitle}</span>
                      <span class="mt-1 block text-xs leading-5 text-slate-600">{service.summary}</span>
                    </span>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={getRoute(locale, link.key)}
              class={`rounded-full px-4 py-2 text-sm font-bold transition ${
                isActive(getRoute(locale, link.key))
                  ? 'bg-blue-50 text-blue-950'
                  : 'text-slate-700 hover:bg-blue-50 hover:text-blue-950'
              }`}
            >
              {link.label}
            </a>
          )
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <div class="hidden items-center rounded-full border border-slate-200 bg-white p-1 text-xs font-black shadow-sm sm:flex" aria-label={t.labels.language}>
          <a
            href={getRoute('en', pageKey)}
            aria-current={locale === 'en' ? 'true' : undefined}
            class={`rounded-full px-3 py-2 transition ${
              locale === 'en' ? 'bg-blue-950 text-white' : 'text-slate-600 hover:bg-blue-50 hover:text-blue-950'
            }`}
          >
            EN
          </a>
          <a
            href={getRoute('fr', pageKey)}
            aria-current={locale === 'fr' ? 'true' : undefined}
            class={`rounded-full px-3 py-2 transition ${
              locale === 'fr' ? 'bg-blue-950 text-white' : 'text-slate-600 hover:bg-blue-50 hover:text-blue-950'
            }`}
          >
            FR
          </a>
        </div>
        <a
          href={primaryPhone.href}
          class="hidden items-center gap-2 rounded-full bg-blue-950 px-5 py-3 text-sm font-black text-white shadow-lg shadow-blue-950/20 transition hover:-translate-y-0.5 hover:bg-blue-800 sm:inline-flex"
        >
          <Icon name="phone" class="h-4 w-4" />
          {t.labels.call} {primaryPhone.display}
        </a>

        <label
          for="mobile-menu-toggle"
          class="grid h-11 w-11 cursor-pointer place-items-center rounded-lg border border-slate-200 bg-white text-blue-950 shadow-sm transition hover:bg-blue-50 lg:hidden"
        >
          <span class="sr-only">{t.labels.openMenu}</span>
          <Icon name="menu" class="h-6 w-6" />
        </label>
      </div>
    </div>
  </div>

  <div class="hidden border-t border-slate-200 bg-white shadow-xl peer-checked:block lg:hidden">
    <nav class="section-shell flex flex-col gap-2 py-4" aria-label={t.labels.mobileNavigation}>
      {t.navLinks.map((link) => (
        <a
          href={getRoute(locale, link.key)}
          class={`rounded-lg px-4 py-3 text-sm font-black transition ${
            isActive(getRoute(locale, link.key))
              ? 'bg-blue-50 text-blue-950'
              : 'text-slate-700 hover:bg-blue-50 hover:text-blue-950'
          }`}
        >
          {link.label}
        </a>
      ))}
      <div class="mt-2 border-t border-slate-200 pt-3">
        <p class="px-4 py-2 text-xs font-black uppercase text-slate-500">{t.labels.serviceSpecialties}</p>
        {t.services.map((service) => (
          <a
            href={getRoute(locale, service.pageKey)}
            class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-bold text-slate-700 transition hover:bg-blue-50 hover:text-blue-950"
          >
            <Icon name={service.icon} class="h-4 w-4 text-green-600" />
            {service.navTitle}
          </a>
        ))}
      </div>
      <div class="mt-2 grid grid-cols-2 gap-2 border-t border-slate-200 pt-4" aria-label={t.labels.language}>
        <a
          href={getRoute('en', pageKey)}
          aria-current={locale === 'en' ? 'true' : undefined}
          class={`rounded-lg px-4 py-3 text-center text-sm font-black transition ${
            locale === 'en' ? 'bg-blue-950 text-white' : 'bg-slate-50 text-slate-700 hover:bg-blue-50 hover:text-blue-950'
          }`}
        >
          EN
        </a>
        <a
          href={getRoute('fr', pageKey)}
          aria-current={locale === 'fr' ? 'true' : undefined}
          class={`rounded-lg px-4 py-3 text-center text-sm font-black transition ${
            locale === 'fr' ? 'bg-blue-950 text-white' : 'bg-slate-50 text-slate-700 hover:bg-blue-50 hover:text-blue-950'
          }`}
        >
          FR
        </a>
      </div>
      <div class="mt-2 border-t border-slate-200 pt-4">
        <a
          href={primaryPhone.href}
          class="flex w-full items-center justify-center gap-2 rounded-full bg-blue-950 px-5 py-3 text-sm font-black text-white shadow-lg shadow-blue-950/20 transition hover:bg-blue-800"
        >
          <Icon name="phone" class="h-4 w-4" />
          {t.labels.call} {primaryPhone.display}
        </a>
      </div>
    </nav>
  </div>
</header>
