---
import Icon from './Icon.astro';
import { business, navLinks, services } from '../data/site';

const normalizePath = (path: string) => (path === '/' ? '/' : path.replace(/\/$/, ''));
const currentPath = normalizePath(Astro.url.pathname);

const isActive = (href: string) => {
  const normalizedHref = normalizePath(href);
  return normalizedHref === '/'
    ? currentPath === '/'
    : currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
};
---

<header class="sticky top-0 z-50 border-b border-white/70 bg-white/90 shadow-[0_10px_30px_rgba(15,23,42,0.08)] backdrop-blur-xl">
  <input type="checkbox" id="mobile-menu-toggle" class="peer sr-only" aria-label="Toggle mobile menu" />

  <div class="section-shell">
    <div class="flex h-20 items-center justify-between gap-4">
      <a href="/" class="flex min-w-0 items-center gap-3 text-blue-950" aria-label={`${business.name} home`}>
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-blue-950 text-lg font-black text-white shadow-lg shadow-blue-950/20">
          R
        </span>
        <span class="min-w-0">
          <span class="block truncate text-base font-black leading-5 sm:text-lg">{business.name}</span>
          <span class="hidden text-xs font-semibold text-blue-700 sm:block">{business.tagline}</span>
        </span>
      </a>

      <nav class="hidden items-center gap-1 lg:flex" aria-label="Main navigation">
        {navLinks.map((link) => (
          link.href === '/services' ? (
            <div class="group relative">
              <a
                href={link.href}
                class={`inline-flex items-center gap-1 rounded-full px-4 py-2 text-sm font-bold transition ${
                  isActive(link.href)
                    ? 'bg-blue-50 text-blue-950'
                    : 'text-slate-700 hover:bg-blue-50 hover:text-blue-950'
                }`}
              >
                {link.label}
                <Icon name="arrowRight" class="h-4 w-4 rotate-90 transition group-hover:translate-y-0.5" />
              </a>
              <div class="invisible absolute left-0 top-full z-50 mt-3 w-80 translate-y-2 rounded-lg border border-slate-200 bg-white p-2 opacity-0 shadow-2xl shadow-slate-950/10 transition duration-200 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                {services.map((service) => (
                  <a
                    href={service.href}
                    class="flex gap-3 rounded-lg p-3 transition hover:bg-blue-50"
                  >
                    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-blue-950 text-white">
                      <Icon name={service.icon} class="h-5 w-5" />
                    </span>
                    <span>
                      <span class="block text-sm font-black text-blue-950">{service.navTitle}</span>
                      <span class="mt-1 block text-xs leading-5 text-slate-600">{service.summary}</span>
                    </span>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class={`rounded-full px-4 py-2 text-sm font-bold transition ${
                isActive(link.href)
                  ? 'bg-blue-50 text-blue-950'
                  : 'text-slate-700 hover:bg-blue-50 hover:text-blue-950'
              }`}
            >
              {link.label}
            </a>
          )
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <a
          href={business.phoneHref}
          class="hidden items-center gap-2 rounded-full bg-blue-950 px-5 py-3 text-sm font-black text-white shadow-lg shadow-blue-950/20 transition hover:-translate-y-0.5 hover:bg-blue-800 sm:inline-flex"
        >
          <Icon name="phone" class="h-4 w-4" />
          Call {business.phone}
        </a>

        <label
          for="mobile-menu-toggle"
          class="grid h-11 w-11 cursor-pointer place-items-center rounded-lg border border-slate-200 bg-white text-blue-950 shadow-sm transition hover:bg-blue-50 lg:hidden"
        >
          <span class="sr-only">Open menu</span>
          <Icon name="menu" class="h-6 w-6" />
        </label>
      </div>
    </div>
  </div>

  <div class="hidden border-t border-slate-200 bg-white shadow-xl peer-checked:block lg:hidden">
    <nav class="section-shell flex flex-col gap-2 py-4" aria-label="Mobile navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`rounded-lg px-4 py-3 text-sm font-black transition ${
            isActive(link.href)
              ? 'bg-blue-50 text-blue-950'
              : 'text-slate-700 hover:bg-blue-50 hover:text-blue-950'
          }`}
        >
          {link.label}
        </a>
      ))}
      <div class="mt-2 border-t border-slate-200 pt-3">
        <p class="px-4 py-2 text-xs font-black uppercase text-slate-500">Service specialties</p>
        {services.map((service) => (
          <a
            href={service.href}
            class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-bold text-slate-700 transition hover:bg-blue-50 hover:text-blue-950"
          >
            <Icon name={service.icon} class="h-4 w-4 text-green-600" />
            {service.navTitle}
          </a>
        ))}
      </div>
      <div class="mt-2 border-t border-slate-200 pt-4">
        <a
          href={business.phoneHref}
          class="flex w-full items-center justify-center gap-2 rounded-full bg-blue-950 px-5 py-3 text-sm font-black text-white shadow-lg shadow-blue-950/20 transition hover:bg-blue-800"
        >
          <Icon name="phone" class="h-4 w-4" />
          Call {business.phone}
        </a>
      </div>
    </nav>
  </div>
</header>
