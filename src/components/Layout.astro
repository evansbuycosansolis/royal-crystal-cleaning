---
import '../styles/global.css';
import SEO from './SEO.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { businessContact, getContent, type Locale, type PageKey } from '../i18n';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  locale?: Locale;
  pageKey: PageKey;
}

const { title, description, ogTitle, ogDescription, ogImage, locale = 'en', pageKey } = Astro.props;
const t = getContent(locale);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${businessContact.url}/#business`,
  name: t.business.name,
  slogan: t.business.tagline,
  telephone: businessContact.primaryPhone,
  email: businessContact.email,
  description: t.business.description,
  url: businessContact.url,
  image: new URL('/og-image.png', businessContact.url).toString(),
  logo: new URL(businessContact.logoPng, businessContact.url).toString(),
  priceRange: '$$',
  serviceType: t.services.map((service) => service.title),
  contactPoint: businessContact.phones.map((phone) => ({
    '@type': 'ContactPoint',
    telephone: phone.display,
    email: businessContact.email,
    contactType: 'customer service',
  })),
};
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f2f76" />
    <link rel="icon" type="image/png" href={businessContact.logoPng} />
    <link rel="apple-touch-icon" href={businessContact.logoPng} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <SEO
      title={title}
      description={description}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      ogImage={ogImage}
      locale={locale}
      pageKey={pageKey}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-white font-sans text-slate-800 antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:text-sm focus:font-bold focus:text-blue-900 focus:shadow-xl"
    >
      {t.labels.skipToContent}
    </a>
    <Header locale={locale} pageKey={pageKey} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} />
    <script is:inline>
      const revealItems = document.querySelectorAll('.reveal');

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.14 }
        );

        revealItems.forEach((item) => observer.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
