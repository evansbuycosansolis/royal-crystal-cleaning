---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, text, align = 'center' } = Astro.props;
const alignment = align === 'center' ? 'mx-auto text-center' : '';
---

<div class={`reveal max-w-3xl ${alignment}`}>
  {eyebrow && <p class="mb-3 text-sm font-black uppercase text-green-700">{eyebrow}</p>}
  <h2 class="text-3xl font-black leading-tight text-blue-950 sm:text-4xl lg:text-5xl">{title}</h2>
  {text && <p class="mt-4 text-base leading-8 text-slate-600 sm:text-lg">{text}</p>}
</div>
