---
import Icon from './Icon.astro';
import CTASection from './CTASection.astro';
import PageHero from './PageHero.astro';
import SectionIntro from './SectionIntro.astro';
import { businessContact, getContent, getRoute, type Locale, type SiteService } from '../i18n';

interface Props {
  service: SiteService;
  locale?: Locale;
}

const { service, locale = 'en' } = Astro.props;
const t = getContent(locale);
const relatedServices = t.services.filter((item) => item.slug !== service.slug);
---

<PageHero
  title={service.title}
  text={service.summary}
  image={service.image}
  icon={service.icon}
  locale={locale}
/>

<section class="bg-white py-20 sm:py-24">
  <div class="section-shell grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
    <div class="reveal image-zoom aspect-[4/3] shadow-2xl shadow-slate-950/10">
      <img src={service.image} alt={service.imageAlt} width="900" height="675" />
    </div>
    <div class="reveal reveal-delay-1">
      <p class="mb-3 text-sm font-black uppercase text-green-700">{t.serviceDetail.introEyebrow}</p>
      <h2 class="text-3xl font-black leading-tight text-blue-950 sm:text-4xl">
        {t.serviceDetail.introTitle}
      </h2>
      <p class="mt-5 text-lg leading-8 text-slate-600">{service.description}</p>
      <div class="mt-8 grid gap-3 sm:grid-cols-3">
        {service.highlights.map((highlight) => (
          <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
            <Icon name="checkCircle" class="mb-3 h-5 w-5 text-green-600" />
            <p class="text-sm font-black leading-6 text-blue-950">{highlight}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={getRoute(locale, 'contact')}
          class="inline-flex items-center justify-center gap-2 rounded-full bg-blue-950 px-7 py-4 text-base font-black text-white shadow-xl shadow-blue-950/20 transition hover:-translate-y-0.5 hover:bg-blue-800"
        >
          {t.labels.freeEstimate}
          <Icon name="arrowRight" class="h-5 w-5" />
        </a>
        <a
          href={businessContact.phoneHref}
          class="inline-flex items-center justify-center gap-2 rounded-full border border-blue-200 px-7 py-4 text-base font-black text-blue-950 transition hover:-translate-y-0.5 hover:bg-blue-50"
        >
          <Icon name="phone" class="h-5 w-5" />
          {businessContact.phone}
        </a>
      </div>
    </div>
  </div>
</section>

<section class="bg-slate-50 py-20 sm:py-24">
  <div class="section-shell">
    <SectionIntro
      eyebrow={t.serviceDetail.includedEyebrow}
      title={`${t.serviceDetail.highlightsTitlePrefix} ${service.shortTitle}`}
      text={t.serviceDetail.highlightsText}
    />

    <div class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {service.included.map((item) => (
        <div class="reveal flex items-start gap-3 rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
          <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-green-100 text-green-700">
            <Icon name="check" class="h-4 w-4" />
          </span>
          <p class="text-sm font-bold leading-6 text-slate-700">{item}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="bg-white py-20 sm:py-24">
  <div class="section-shell">
    <SectionIntro
      eyebrow={t.serviceDetail.relatedEyebrow}
      title={t.serviceDetail.relatedTitle}
      text={t.serviceDetail.relatedText}
    />
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {relatedServices.map((item) => (
        <a href={getRoute(locale, item.pageKey)} class="premium-card reveal group grid gap-5 overflow-hidden p-5 sm:grid-cols-[180px_1fr]">
          <div class="image-zoom aspect-[4/3] sm:aspect-auto">
            <img src={item.image} alt={item.imageAlt} width="420" height="315" loading="lazy" />
          </div>
          <div>
            <div class="mb-4 grid h-11 w-11 place-items-center rounded-lg bg-blue-50 text-blue-800">
              <Icon name={item.icon} class="h-5 w-5" />
            </div>
            <h3 class="text-xl font-black text-blue-950">{item.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-600">{item.summary}</p>
            <p class="mt-4 inline-flex items-center gap-2 text-sm font-black text-green-700 transition group-hover:gap-3">
              {t.labels.learnMore}
              <Icon name="arrowRight" class="h-4 w-4" />
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<CTASection text={t.serviceDetail.ctaText} locale={locale} />
