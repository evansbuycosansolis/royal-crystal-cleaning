---
interface Props {
  title: string;
  description: string;
  icon: string;
  href: string;
}

const { title, description, icon, href } = Astro.props;
---

<div class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-shadow border border-gray-100 p-6 flex flex-col">
  <div class="text-4xl mb-4" aria-hidden="true">{icon}</div>
  <h3 class="text-xl font-bold text-blue-900 mb-2">{title}</h3>
  <p class="text-gray-600 text-sm leading-relaxed flex-1 mb-5">{description}</p>
  <a
    href={href}
    class="inline-flex items-center gap-1 text-sm font-semibold text-green-700 hover:text-green-800 transition-colors group"
    aria-label={`Learn more about ${title}`}
  >
    Learn More
    <svg
      class="w-4 h-4 group-hover:translate-x-1 transition-transform"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </a>
</div>
