---
import Icon from './Icon.astro';

interface Props {
  title: string;
  description: string;
  icon: string;
  href: string;
  image: string;
  imageAlt: string;
  accent?: 'blue' | 'green' | 'royal';
  ctaLabel?: string;
  ariaLabelPrefix?: string;
}

const {
  title,
  description,
  icon,
  href,
  image,
  imageAlt,
  accent = 'blue',
  ctaLabel = 'Learn More',
  ariaLabelPrefix = 'Learn more about',
} = Astro.props;

const accentClasses = {
  blue: 'bg-blue-50 text-blue-700 ring-blue-100',
  green: 'bg-green-50 text-green-700 ring-green-100',
  royal: 'bg-slate-100 text-blue-950 ring-slate-200',
};
---

<article class="premium-card reveal group flex h-full flex-col overflow-hidden">
  <a href={href} class="image-zoom block aspect-[4/3]" aria-label={`${ariaLabelPrefix} ${title}`}>
    <img src={image} alt={imageAlt} loading="lazy" width="800" height="600" />
  </a>
  <div class="flex flex-1 flex-col p-6">
    <div class={`mb-5 grid h-12 w-12 place-items-center rounded-lg ring-1 ${accentClasses[accent]}`}>
      <Icon name={icon} class="h-6 w-6" />
    </div>
    <h3 class="text-xl font-black leading-7 text-blue-950">{title}</h3>
    <p class="mt-3 flex-1 text-sm leading-7 text-slate-600">{description}</p>
    <a
      href={href}
      class="mt-6 inline-flex items-center gap-2 text-sm font-black text-blue-900 transition group-hover:gap-3 group-hover:text-green-700"
      aria-label={`${ariaLabelPrefix} ${title}`}
    >
      {ctaLabel}
      <Icon name="arrowRight" class="h-4 w-4" />
    </a>
  </div>
</article>
