---
import Layout from '../Layout.astro';
import CTASection from '../CTASection.astro';
import Icon from '../Icon.astro';
import PageHero from '../PageHero.astro';
import SectionIntro from '../SectionIntro.astro';
import { getContent, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getContent(locale);
const page = t.pages.about;
---

<Layout title={page.title} description={page.description} locale={locale} pageKey="about">
  <PageHero title={page.heroTitle} text={page.heroText} image="/images/about-team.webp" icon="sparkles" locale={locale} />

  <section class="bg-white py-20 sm:py-24">
    <div class="section-shell grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div class="reveal">
        <p class="mb-3 text-sm font-black uppercase text-green-700">{t.business.tagline}</p>
        <h2 class="text-3xl font-black leading-tight text-blue-950 sm:text-4xl lg:text-5xl">
          {page.introTitle}
        </h2>
        <div class="mt-6 space-y-5 text-lg leading-8 text-slate-600">
          {page.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      <div class="reveal reveal-delay-1 image-zoom aspect-[4/5] shadow-2xl shadow-slate-950/10">
        <img src="/images/about-team.webp" alt={page.imageAlt} width="900" height="1125" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-20 sm:py-24">
    <div class="section-shell">
      <SectionIntro eyebrow={page.whyEyebrow} title={page.whyTitle} text={page.whyText} />
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-5">
        {t.whyChooseUs.map((item) => (
          <article class="premium-card reveal p-5">
            <div class="mb-5 grid h-12 w-12 place-items-center rounded-lg bg-blue-50 text-blue-800">
              <Icon name={item.icon} class="h-6 w-6" />
            </div>
            <h3 class="text-lg font-black leading-7 text-blue-950">{item.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-600">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-20 sm:py-24">
    <div class="section-shell">
      <SectionIntro eyebrow={page.commitmentEyebrow} title={page.commitmentTitle} />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {page.values.map(([title, text, icon]) => (
          <article class="premium-card reveal p-7 text-center">
            <div class="mx-auto mb-5 grid h-14 w-14 place-items-center rounded-lg bg-green-50 text-green-700">
              <Icon name={icon} class="h-7 w-7" />
            </div>
            <h3 class="text-xl font-black text-blue-950">{title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-600">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection text={page.ctaText} locale={locale} />
</Layout>
