---
import Layout from '../Layout.astro';
import ServiceCard from '../ServiceCard.astro';
import CTASection from '../CTASection.astro';
import Icon from '../Icon.astro';
import PageHero from '../PageHero.astro';
import SectionIntro from '../SectionIntro.astro';
import { businessContact, getContent, getRoute, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getContent(locale);
const page = t.pages.services;
---

<Layout title={page.title} description={page.description} locale={locale} pageKey="services">
  <PageHero
    title={page.heroTitle}
    text={page.heroText}
    image="/images/commercial-cleaning.webp"
    icon="sparkles"
    locale={locale}
  />

  <section class="bg-white py-20 sm:py-24">
    <div class="section-shell">
      <SectionIntro eyebrow={page.introEyebrow} title={page.introTitle} text={page.introText} />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {t.services.map((service) => (
          <ServiceCard
            title={service.title}
            description={service.summary}
            icon={service.icon}
            href={getRoute(locale, service.pageKey)}
            image={service.image}
            imageAlt={service.imageAlt}
            accent={service.accent}
            ctaLabel={t.labels.learnMore}
            ariaLabelPrefix={t.labels.learnMoreAbout}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-20 sm:py-24">
    <div class="section-shell grid gap-6 md:grid-cols-3">
      {page.steps.map(([title, text], index) => (
        <article class="premium-card reveal p-6">
          <div class="mb-5 grid h-12 w-12 place-items-center rounded-lg bg-blue-50 text-blue-800">
            <span class="text-lg font-black">{index + 1}</span>
          </div>
          <h2 class="text-xl font-black text-blue-950">{title}</h2>
          <p class="mt-3 text-sm leading-7 text-slate-600">{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="section-shell">
      <div class="reveal rounded-lg border border-blue-100 bg-blue-50 p-6 sm:flex sm:items-center sm:justify-between sm:gap-6">
        <div>
          <h2 class="text-2xl font-black text-blue-950">{page.multiTitle}</h2>
          <p class="mt-2 text-sm leading-7 text-slate-600">{page.multiText}</p>
        </div>
        <a
          href={businessContact.phoneHref}
          class="mt-5 inline-flex items-center justify-center gap-2 rounded-full bg-blue-950 px-6 py-3 text-sm font-black text-white transition hover:-translate-y-0.5 hover:bg-blue-800 sm:mt-0"
        >
          <Icon name="phone" class="h-4 w-4" />
          {t.labels.call} {businessContact.phone}
        </a>
      </div>
    </div>
  </section>

  <CTASection text={page.ctaText} locale={locale} />
</Layout>
