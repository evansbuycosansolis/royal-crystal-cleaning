---
import Layout from '../Layout.astro';
import Hero from '../Hero.astro';
import ServiceCard from '../ServiceCard.astro';
import CTASection from '../CTASection.astro';
import Icon from '../Icon.astro';
import SectionIntro from '../SectionIntro.astro';
import TestimonialCard from '../TestimonialCard.astro';
import { getContent, getRoute, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getContent(locale);
const page = t.pages.home;
---

<Layout title={page.title} description={page.description} locale={locale} pageKey="home">
  <Hero
    headline={t.business.name}
    subheadline={t.business.catchphrase}
    text={page.heroText}
    showButtons={true}
    locale={locale}
  />

  <section class="bg-white py-20 sm:py-24">
    <div class="section-shell">
      <SectionIntro eyebrow={page.servicesEyebrow} title={page.servicesTitle} text={page.servicesText} />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {t.services.map((service) => (
          <ServiceCard
            title={service.title}
            description={service.summary}
            icon={service.icon}
            href={getRoute(locale, service.pageKey)}
            image={service.image}
            imageAlt={service.imageAlt}
            accent={service.accent}
            ctaLabel={t.labels.learnMore}
            ariaLabelPrefix={t.labels.learnMoreAbout}
          />
        ))}
      </div>
      <div class="reveal mt-12 text-center">
        <a
          href={getRoute(locale, 'services')}
          class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-white px-7 py-4 text-base font-black text-blue-950 shadow-sm transition hover:-translate-y-0.5 hover:bg-blue-50"
        >
          {page.viewAllServices}
          <Icon name="arrowRight" class="h-5 w-5" />
        </a>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-slate-50 py-20 sm:py-24">
    <div class="absolute inset-0 soft-grid opacity-60" aria-hidden="true"></div>
    <div class="section-shell relative grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div class="reveal image-zoom aspect-[4/5] shadow-2xl shadow-slate-950/10">
        <img src="/images/about-team.webp" alt={t.pages.about.imageAlt} width="900" height="1125" loading="lazy" />
      </div>
      <div class="reveal reveal-delay-1">
        <p class="mb-3 text-sm font-black uppercase text-green-700">{page.aboutEyebrow}</p>
        <h2 class="text-3xl font-black leading-tight text-blue-950 sm:text-4xl lg:text-5xl">
          {page.aboutTitle}
        </h2>
        {page.aboutParagraphs.map((paragraph) => (
          <p class="mt-5 text-lg leading-8 text-slate-600">{paragraph}</p>
        ))}
        <div class="mt-8 grid gap-3 sm:grid-cols-2">
          {page.aboutHighlights.map((item) => (
            <div class="flex items-center gap-3 rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
              <Icon name="checkCircle" class="h-5 w-5 text-green-600" />
              <p class="text-sm font-black text-blue-950">{item}</p>
            </div>
          ))}
        </div>
        <a
          href={getRoute(locale, 'about')}
          class="mt-8 inline-flex items-center gap-2 rounded-full bg-blue-950 px-7 py-4 text-base font-black text-white shadow-xl shadow-blue-950/20 transition hover:-translate-y-0.5 hover:bg-blue-800"
        >
          {page.aboutLink}
          <Icon name="arrowRight" class="h-5 w-5" />
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 sm:py-24">
    <div class="section-shell">
      <SectionIntro eyebrow={page.whyEyebrow} title={page.whyTitle} text={page.whyText} />
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-5">
        {t.whyChooseUs.map((item) => (
          <article class="premium-card reveal p-5">
            <div class="mb-5 grid h-12 w-12 place-items-center rounded-lg bg-blue-50 text-blue-800">
              <Icon name={item.icon} class="h-6 w-6" />
            </div>
            <h3 class="text-lg font-black leading-7 text-blue-950">{item.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-600">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-20 sm:py-24">
    <div class="section-shell">
      <SectionIntro eyebrow={page.galleryEyebrow} title={page.galleryTitle} text={page.galleryText} />
      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {t.gallery.map((item, index) => (
          <article class={`reveal premium-card overflow-hidden ${index === 0 ? 'lg:row-span-2' : ''}`}>
            <div class={`image-zoom ${index === 0 ? 'aspect-[4/5]' : 'aspect-[4/3]'}`}>
              <img src={item.src} alt={item.alt} width="900" height="675" loading="lazy" />
            </div>
            <div class="p-6">
              <h3 class="text-xl font-black text-blue-950">{item.title}</h3>
              <p class="mt-2 text-sm leading-7 text-slate-600">{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-20 sm:py-24">
    <div class="section-shell">
      <SectionIntro eyebrow={page.testimonialsEyebrow} title={page.testimonialsTitle} text={page.testimonialsText} />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {t.testimonials.map((testimonial) => (
          <TestimonialCard quote={testimonial.quote} name={testimonial.name} label={testimonial.label} />
        ))}
      </div>
    </div>
  </section>

  <CTASection text={page.ctaText} title={page.ctaTitle} locale={locale} />
</Layout>
