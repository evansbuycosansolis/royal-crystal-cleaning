---
import Layout from '../Layout.astro';
import Icon from '../Icon.astro';
import PageHero from '../PageHero.astro';
import SectionIntro from '../SectionIntro.astro';
import { businessContact, getBusinessPhones, getContent, getRoute, type Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getContent(locale);
const page = t.pages.contact;
const phones = getBusinessPhones(locale);
const phoneCard = t.contactCards.find((card) => card.icon === 'phone');
const otherContactCards = t.contactCards.filter((card) => card.icon !== 'phone');
---

<Layout title={page.title} description={page.description} locale={locale} pageKey="contact">
  <PageHero title={page.heroTitle} text={page.heroText} image="/images/hero-cleaning.webp" icon="mail" locale={locale} />

  <section class="bg-white py-20 sm:py-24">
    <div class="section-shell">
      <SectionIntro eyebrow={page.introEyebrow} title={page.introTitle} text={page.introText} />

      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {phoneCard && (
          <div class="premium-card reveal group p-6">
            <div class="mb-5 grid h-12 w-12 place-items-center rounded-lg bg-blue-50 text-blue-800">
              <Icon name={phoneCard.icon} class="h-6 w-6" />
            </div>
            <h2 class="text-xl font-black text-blue-950">{phoneCard.title}</h2>
            <div class="mt-4 grid gap-3">
              {phones.map((phone) => (
                <a
                  href={phone.href}
                  class="inline-flex items-center gap-2 text-sm font-semibold leading-7 text-slate-600 transition hover:text-blue-900"
                >
                  <Icon name="phone" class="h-4 w-4 text-green-700" />
                  {phone.display}
                </a>
              ))}
            </div>
            <p class="mt-5 inline-flex items-center gap-2 text-sm font-black text-green-700">
              {t.labels.contact}
              <Icon name="arrowRight" class="h-4 w-4" />
            </p>
          </div>
        )}
        {otherContactCards.map((card) => (
          <a href={card.href} class="premium-card reveal group p-6">
            <div class="mb-5 grid h-12 w-12 place-items-center rounded-lg bg-blue-50 text-blue-800">
              <Icon name={card.icon} class="h-6 w-6" />
            </div>
            <h2 class="text-xl font-black text-blue-950">{card.title}</h2>
            <p class="mt-3 break-words text-sm font-semibold leading-7 text-slate-600">{card.text}</p>
            <p class="mt-5 inline-flex items-center gap-2 text-sm font-black text-green-700 transition group-hover:gap-3">
              {t.labels.contact}
              <Icon name="arrowRight" class="h-4 w-4" />
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-20 sm:py-24">
    <div class="section-shell grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div class="reveal image-zoom aspect-[4/5] shadow-2xl shadow-slate-950/10">
        <img src="/images/commercial-cleaning.webp" alt={page.contactImageAlt} width="900" height="1125" loading="lazy" />
      </div>

      <div class="reveal reveal-delay-1">
        <p class="mb-3 text-sm font-black uppercase text-green-700">{page.estimateEyebrow}</p>
        <h2 class="text-3xl font-black leading-tight text-blue-950 sm:text-4xl">
          {page.estimateTitle}
        </h2>
        <div class="mt-8 grid gap-4">
          {page.details.map((item) => (
            <div class="flex gap-4 rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-green-100 text-green-700">
                <Icon name="check" class="h-4 w-4" />
              </span>
              <p class="text-sm font-bold leading-7 text-slate-700">{item}</p>
            </div>
          ))}
        </div>

        <div class="mt-8 rounded-lg bg-blue-950 p-6 text-white">
          <p class="text-lg font-black">{t.business.name}</p>
          <p class="mt-2 text-sm leading-7 text-blue-100">{t.business.catchphrase}</p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            {phones.map((phone) => (
              <a
                href={phone.href}
                class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-black text-blue-950 transition hover:bg-blue-50"
              >
                <Icon name="phone" class="h-4 w-4" />
                {phone.display}
              </a>
            ))}
            <a
              href={businessContact.emailHref}
              class="inline-flex items-center justify-center gap-2 rounded-full border border-white/25 px-6 py-3 text-sm font-black text-white transition hover:bg-white/10"
            >
              <Icon name="mail" class="h-4 w-4" />
              {t.labels.emailUs}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 sm:py-24">
    <div class="section-shell">
      <SectionIntro eyebrow={page.optionsEyebrow} title={page.optionsTitle} text={page.optionsText} />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {t.services.map((service) => (
          <a href={getRoute(locale, service.pageKey)} class="premium-card reveal group overflow-hidden">
            <div class="image-zoom aspect-[4/3]">
              <img src={service.image} alt={service.imageAlt} width="700" height="525" loading="lazy" />
            </div>
            <div class="p-5">
              <h3 class="text-lg font-black text-blue-950">{service.title}</h3>
              <p class="mt-2 text-sm leading-7 text-slate-600">{service.summary}</p>
              <p class="mt-4 inline-flex items-center gap-2 text-sm font-black text-green-700 transition group-hover:gap-3">
                {t.labels.viewService}
                <Icon name="arrowRight" class="h-4 w-4" />
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
