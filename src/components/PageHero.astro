---
import Icon from './Icon.astro';
import { getContent, type Locale } from '../i18n';

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  image?: string;
  icon?: string;
  locale?: Locale;
}

const {
  eyebrow,
  title,
  text,
  image = '/images/hero-cleaning.webp',
  icon = 'sparkles',
  locale = 'en',
} = Astro.props;

const t = getContent(locale);
const resolvedEyebrow = eyebrow ?? t.business.tagline;
---

<section class="relative overflow-hidden bg-blue-950 text-white">
  <div
    class="absolute inset-0 bg-cover bg-center"
    style={`background-image: linear-gradient(90deg, rgba(9, 24, 61, 0.94), rgba(15, 47, 118, 0.76), rgba(15, 47, 118, 0.46)), url('${image}');`}
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-0 soft-grid opacity-20" aria-hidden="true"></div>
  <div class="section-shell relative py-20 sm:py-24">
    <div class="max-w-3xl reveal">
      <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-bold text-blue-50 backdrop-blur-md">
        <Icon name={icon} class="h-4 w-4 text-green-300" />
        {resolvedEyebrow}
      </p>
      <h1 class="text-4xl font-black leading-tight sm:text-5xl lg:text-6xl">{title}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-blue-50/90 sm:text-xl">{text}</p>
    </div>
  </div>
</section>
