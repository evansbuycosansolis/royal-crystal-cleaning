---
import Layout from '../../components/Layout.astro';
import CTASection from '../../components/CTASection.astro';

const servicesList = [
  'Garden design consultation',
  'Seasonal planting packages',
  'Garden maintenance',
  'Custom landscaping projects',
  'Lawn mowing, trimming, edging',
  'Weed control',
  'Garden bed cleaning and planting',
  'Hedge and shrub care',
  'Leaf removal',
  'Seasonal cleanup',
  'Yard cleanup',
];
---

<Layout
  title="Lawn & Garden Care | Royal Crystal Cleaning"
  description="Professional lawn mowing, garden design, trimming, and seasonal cleanup services."
>
  <!-- Page Hero -->
  <section class="bg-gradient-to-br from-blue-900 to-blue-800 text-white py-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <div class="text-5xl mb-4" aria-hidden="true">🌿</div>
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-4">Lawn &amp; Garden Care</h1>
      <p class="text-blue-200 text-lg max-w-2xl mx-auto">
        Beautiful lawns, gardens, and outdoor spaces tailored to your property.
      </p>
    </div>
  </section>

  <!-- Content -->
  <section class="py-20 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <p class="text-lg text-gray-600 leading-relaxed mb-10">
        We provide lawn and garden care services for residential and commercial properties.
      </p>

      <h2 class="text-2xl font-bold text-blue-900 mb-6">Services Included</h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {servicesList.map((item) => (
          <li class="flex items-start gap-3 bg-gray-50 rounded-xl px-4 py-3 border border-gray-100">
            <span class="text-green-600 font-bold text-lg flex-shrink-0" aria-hidden="true">✓</span>
            <span class="text-gray-700">{item}</span>
          </li>
        ))}
      </ul>

      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-blue-900 text-white font-bold rounded-xl hover:bg-blue-800 transition-colors"
        >
          Get a Free Estimate
        </a>
        <a
          href="tel:2637888063"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 border-2 border-blue-900 text-blue-900 font-bold rounded-xl hover:bg-blue-900 hover:text-white transition-colors"
        >
          <span aria-hidden="true">📞</span> 263-788-8063
        </a>
      </div>
    </div>
  </section>

  <CTASection text="Transform your outdoor space. Contact Royal Crystal Cleaning for professional lawn and garden care." />
</Layout>
