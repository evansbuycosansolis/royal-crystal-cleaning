---
import Layout from '../../components/Layout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTASection from '../../components/CTASection.astro';

const services = [
  {
    title: 'Residential & Commercial Cleaning',
    description: 'Crystal-clear cleaning for homes, apartments, condos, offices, and commercial properties.',
    icon: '🏠',
    href: '/services/cleaning',
  },
  {
    title: 'Handyman & Property Maintenance',
    description: 'Reliable repairs, installations, and upkeep for residential and commercial properties.',
    icon: '🔧',
    href: '/services/maintenance',
  },
  {
    title: 'Lawn & Garden Care',
    description: 'Beautiful lawns, gardens, and outdoor spaces tailored to your property.',
    icon: '🌿',
    href: '/services/lawn-garden',
  },
];
---

<Layout
  title="Our Services | Royal Crystal Cleaning"
  description="Explore Royal Crystal Cleaning's full range of services including cleaning, maintenance, and lawn care."
>
  <!-- Page Hero -->
  <section class="bg-gradient-to-br from-blue-900 to-blue-800 text-white py-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-4">Our Services</h1>
      <p class="text-blue-200 text-lg max-w-2xl mx-auto">
        From spotless interiors to manicured lawns, we offer a complete range of property care solutions.
      </p>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-20 px-4 bg-gray-100">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-extrabold text-blue-900 mb-3">What We Offer</h2>
        <p class="text-gray-600 max-w-xl mx-auto">Choose from our range of professional services designed to keep your property in perfect condition.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service) => (
          <ServiceCard
            title={service.title}
            description={service.description}
            icon={service.icon}
            href={service.href}
          />
        ))}
      </div>
    </div>
  </section>

  <CTASection text="Not sure which service you need? Contact us and we'll help you find the right solution." />
</Layout>
