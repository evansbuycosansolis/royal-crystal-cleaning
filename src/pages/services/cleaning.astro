---
import Layout from '../../components/Layout.astro';
import ServiceDetail from '../../components/ServiceDetail.astro';
import { services } from '../../data/site';

const service = services.find((item) => item.slug === 'cleaning');

if (!service) {
  throw new Error('Cleaning service data was not found.');
}
---

<Layout
  title={service.metaTitle}
  description={service.metaDescription}
  ogImage={new URL(service.image, 'https://royalcrystalcleaning.com').toString()}
>
  <ServiceDetail service={service} />
</Layout>
