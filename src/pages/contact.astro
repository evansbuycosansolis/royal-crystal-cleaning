---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionIntro from '../components/SectionIntro.astro';
import { business, contactCards, services } from '../data/site';
---

<Layout
  title="Contact Us | Royal Crystal Cleaning"
  description="Contact Royal Crystal Cleaning for a free estimate on cleaning, maintenance, or lawn care services."
>
  <PageHero
    title="Get a Free Estimate"
    text="Reach out by phone or email and let us know how Royal Crystal Cleaning can help with your property."
    image="/images/hero-cleaning.webp"
    icon="mail"
  />

  <section class="bg-white py-20 sm:py-24">
    <div class="section-shell">
      <SectionIntro
        eyebrow="Contact"
        title="Call or email for a clear, friendly next step"
        text="No booking portal or complicated form. Just direct contact for a free estimate."
      />

      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {contactCards.map((card) => (
          <a href={card.href} class="premium-card reveal group p-6">
            <div class="mb-5 grid h-12 w-12 place-items-center rounded-lg bg-blue-50 text-blue-800">
              <Icon name={card.icon} class="h-6 w-6" />
            </div>
            <h2 class="text-xl font-black text-blue-950">{card.title}</h2>
            <p class="mt-3 break-words text-sm font-semibold leading-7 text-slate-600">{card.text}</p>
            <p class="mt-5 inline-flex items-center gap-2 text-sm font-black text-green-700 transition group-hover:gap-3">
              Contact
              <Icon name="arrowRight" class="h-4 w-4" />
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-20 sm:py-24">
    <div class="section-shell grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div class="reveal image-zoom aspect-[4/5] shadow-2xl shadow-slate-950/10">
        <img src="/images/commercial-cleaning.webp" alt="Professional cleaners wiping glass and a reception counter in a modern office" width="900" height="1125" loading="lazy" />
      </div>

      <div class="reveal reveal-delay-1">
        <p class="mb-3 text-sm font-black uppercase text-green-700">Free estimate details</p>
        <h2 class="text-3xl font-black leading-tight text-blue-950 sm:text-4xl">
          Helpful details to include when you reach out
        </h2>
        <div class="mt-8 grid gap-4">
          {[
            'Property type: home, condo, apartment, office, business, or outdoor space',
            'Service needed: cleaning, maintenance, lawn and garden care, or multiple services',
            'Timing: one-time help, regular service, move-in/move-out, seasonal cleanup, or urgent support',
            'Contact preference: phone call or email reply',
          ].map((item) => (
            <div class="flex gap-4 rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-green-100 text-green-700">
                <Icon name="check" class="h-4 w-4" />
              </span>
              <p class="text-sm font-bold leading-7 text-slate-700">{item}</p>
            </div>
          ))}
        </div>

        <div class="mt-8 rounded-lg bg-blue-950 p-6 text-white">
          <p class="text-lg font-black">{business.name}</p>
          <p class="mt-2 text-sm leading-7 text-blue-100">{business.catchphrase}</p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <a
              href={business.phoneHref}
              class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-black text-blue-950 transition hover:bg-blue-50"
            >
              <Icon name="phone" class="h-4 w-4" />
              {business.phone}
            </a>
            <a
              href={business.emailHref}
              class="inline-flex items-center justify-center gap-2 rounded-full border border-white/25 px-6 py-3 text-sm font-black text-white transition hover:bg-white/10"
            >
              <Icon name="mail" class="h-4 w-4" />
              Email Us
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 sm:py-24">
    <div class="section-shell">
      <SectionIntro
        eyebrow="Service options"
        title="What can we help with?"
        text="Tell us which area sounds closest to what you need. We can help narrow it down."
      />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {services.map((service) => (
          <a href={service.href} class="premium-card reveal group overflow-hidden">
            <div class="image-zoom aspect-[4/3]">
              <img src={service.image} alt={service.imageAlt} width="700" height="525" loading="lazy" />
            </div>
            <div class="p-5">
              <h3 class="text-lg font-black text-blue-950">{service.title}</h3>
              <p class="mt-2 text-sm leading-7 text-slate-600">{service.summary}</p>
              <p class="mt-4 inline-flex items-center gap-2 text-sm font-black text-green-700 transition group-hover:gap-3">
                View Service
                <Icon name="arrowRight" class="h-4 w-4" />
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
