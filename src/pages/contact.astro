---
import Layout from '../components/Layout.astro';
---

<Layout
  title="Contact Us | Royal Crystal Cleaning"
  description="Contact Royal Crystal Cleaning for a free estimate on cleaning, maintenance, or lawn care services."
>
  <!-- Page Hero -->
  <section class="bg-gradient-to-br from-blue-900 to-blue-800 text-white py-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <div class="text-5xl mb-4" aria-hidden="true">✉️</div>
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-4">Get a Free Estimate</h1>
      <p class="text-blue-200 text-lg max-w-xl mx-auto">
        We respond within 24 hours. Reach out and let us know how we can help.
      </p>
    </div>
  </section>

  <!-- Contact Content -->
  <section class="py-20 px-4 bg-gray-100">
    <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10">

      <!-- Contact Info -->
      <div>
        <h2 class="text-2xl font-extrabold text-blue-900 mb-6">Contact Information</h2>

        <div class="space-y-5 mb-8">
          <div class="flex items-start gap-4 bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
            <span class="text-3xl flex-shrink-0" aria-hidden="true">📞</span>
            <div>
              <p class="text-sm text-gray-500 font-medium mb-1">Phone</p>
              <a href="tel:2637888063" class="text-xl font-bold text-blue-900 hover:text-blue-700 transition-colors">
                263-788-8063
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4 bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
            <span class="text-3xl flex-shrink-0" aria-hidden="true">✉️</span>
            <div>
              <p class="text-sm text-gray-500 font-medium mb-1">Email</p>
              <a href="mailto:info@royalcrystalcleaning.com" class="text-lg font-bold text-blue-900 hover:text-blue-700 transition-colors break-all">
                info@royalcrystalcleaning.com
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4 bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
            <span class="text-3xl flex-shrink-0" aria-hidden="true">⏱️</span>
            <div>
              <p class="text-sm text-gray-500 font-medium mb-1">Response Time</p>
              <p class="text-gray-700 font-semibold">We respond within 24 hours</p>
            </div>
          </div>
        </div>

        <div class="bg-blue-900 rounded-2xl p-6 text-white">
          <div class="text-2xl mb-2" aria-hidden="true">👑</div>
          <h3 class="font-bold text-lg mb-1">Royal Crystal Cleaning</h3>
          <p class="text-blue-200 text-sm">The King of Crystal Clear Cleaning</p>
          <p class="text-blue-200 text-sm mt-2">Cleaning, maintenance, and lawn care you can trust.</p>
        </div>
      </div>

      <!-- Contact Form -->
      <div>
        <h2 class="text-2xl font-extrabold text-blue-900 mb-6">Send Us a Message</h2>
        <form
          action="mailto:info@royalcrystalcleaning.com"
          method="POST"
          enctype="text/plain"
          class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 space-y-5"
        >
          <div>
            <label for="name" class="block text-sm font-semibold text-gray-700 mb-1.5">
              Full Name <span class="text-red-500" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Your full name"
              class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-900 focus:border-transparent text-gray-800 placeholder-gray-400"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-gray-700 mb-1.5">
              Email Address <span class="text-red-500" aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="your@email.com"
              class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-900 focus:border-transparent text-gray-800 placeholder-gray-400"
            />
          </div>

          <div>
            <label for="phone" class="block text-sm font-semibold text-gray-700 mb-1.5">
              Phone Number
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              placeholder="Your phone number"
              class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-900 focus:border-transparent text-gray-800 placeholder-gray-400"
            />
          </div>

          <div>
            <label for="service" class="block text-sm font-semibold text-gray-700 mb-1.5">
              Service Interested In
            </label>
            <select
              id="service"
              name="service"
              class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-900 focus:border-transparent text-gray-800 bg-white"
            >
              <option value="">Select a service...</option>
              <option value="cleaning">Residential &amp; Commercial Cleaning</option>
              <option value="maintenance">Handyman &amp; Property Maintenance</option>
              <option value="lawn-garden">Lawn &amp; Garden Care</option>
              <option value="multiple">Multiple Services</option>
              <option value="other">Other / Not Sure</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-gray-700 mb-1.5">
              Message <span class="text-red-500" aria-hidden="true">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="4"
              placeholder="Tell us about your needs..."
              class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-900 focus:border-transparent text-gray-800 placeholder-gray-400 resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3.5 bg-blue-900 text-white font-bold rounded-xl hover:bg-blue-800 transition-colors text-base"
          >
            Send Message
          </button>

          <p class="text-xs text-gray-500 text-center">
            We respond within 24 hours. You can also reach us directly at&nbsp;
            <a href="tel:2637888063" class="text-blue-900 hover:underline font-medium">263-788-8063</a>.
          </p>
        </form>
      </div>
    </div>
  </section>
</Layout>
