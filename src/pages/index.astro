---
import Layout from '../components/Layout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTASection from '../components/CTASection.astro';

const services = [
  {
    title: 'Residential & Commercial Cleaning',
    description: 'Crystal-clear cleaning for homes, apartments, condos, offices, and commercial properties.',
    icon: '🏠',
    href: '/services/cleaning',
  },
  {
    title: 'Handyman & Property Maintenance',
    description: 'Reliable repairs, installations, and upkeep for residential and commercial properties.',
    icon: '🔧',
    href: '/services/maintenance',
  },
  {
    title: 'Lawn & Garden Care',
    description: 'Beautiful lawns, gardens, and outdoor spaces tailored to your property.',
    icon: '🌿',
    href: '/services/lawn-garden',
  },
];

const whyChooseUs = [
  'Commitment to excellence',
  'Personalized solutions for every client',
  'Health, safety, and peace of mind focused',
  'Eco-friendly and family-safe practices',
  'Reliable, high-quality results you can trust',
];
---

<Layout
  title="Royal Crystal Cleaning | Professional Cleaning, Maintenance & Lawn Care"
  description="Royal Crystal Cleaning offers professional residential and commercial cleaning, handyman maintenance, and lawn care services. The King of Crystal Clear Cleaning."
>
  <!-- Hero -->
  <Hero
    headline="Royal Crystal Cleaning"
    subheadline="Cleaning, maintenance, and lawn care you can trust."
    text="From crystal-clear indoor cleaning to beautiful outdoor spaces, we help keep your home, property, and business fresh, clean, healthy, and well maintained."
    showButtons={true}
  />

  <!-- Services -->
  <section class="py-20 px-4 bg-gray-100">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-blue-900 mb-3">Our Services</h2>
        <p class="text-gray-600 max-w-xl mx-auto">
          Comprehensive property care solutions for homes and businesses.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service) => (
          <ServiceCard
            title={service.title}
            description={service.description}
            icon={service.icon}
            href={service.href}
          />
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/services" class="inline-flex items-center gap-2 px-6 py-3 border-2 border-blue-900 text-blue-900 font-semibold rounded-xl hover:bg-blue-900 hover:text-white transition-colors">
          View All Services
        </a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="py-20 px-4 bg-white">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-blue-900 mb-4">About Royal Crystal Cleaning</h2>
      <p class="text-gray-600 text-lg leading-relaxed">
        Royal Crystal Cleaning has built a strong reputation for exceptional residential, commercial,
        specialized, and property maintenance services. Our team is committed to service excellence,
        attention to detail, and personalized solutions.
      </p>
      <a href="/about" class="inline-flex items-center gap-2 mt-8 px-6 py-3 border-2 border-blue-900 text-blue-900 font-semibold rounded-xl hover:bg-blue-900 hover:text-white transition-colors">
        Learn More About Us
      </a>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-20 px-4 bg-gray-100">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-blue-900 mb-3">Why Choose Royal Crystal Cleaning?</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {whyChooseUs.map((reason) => (
          <div class="flex items-start gap-3 bg-white rounded-xl p-4 shadow-sm">
            <span class="text-green-600 text-xl flex-shrink-0 mt-0.5" aria-hidden="true">✅</span>
            <p class="text-gray-700 font-medium">{reason}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTASection text="Ready for a cleaner, safer, and better-maintained property? Contact Royal Crystal Cleaning today for a free estimate." />
</Layout>
